# LOCAL ONLY. Start with DOTENV_CONFIG_PATH=.env.otp-preview, never merge with a live .env.
# Copy this file to .env.otp-preview (ignored). Run a local MongoDB replica set.
NODE_ENV=development
PORT=5001
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MONGO_URI=mongodb://127.0.0.1:27017/gfu_otp_test_local?replicaSet=rs0
OTP_MODE=development_preview
OTP_DEV_PREVIEW_ENABLED=true
OTP_PREVIEW_TIER=local
WHATSAPP_MODE=disabled
# No Firebase, WhatsApp, payment, email or storage credentials are permitted here.
# Generates random single-use codes on the signup and OTP login screens.
# Login previews accept only active non-admin accounts created in this test mode.
# Production delivery failures never expose codes. No messages are sent here.
# Disable by restoring OTP_MODE=whatsapp and OTP_DEV_PREVIEW_ENABLED=false.
# Existing simulated accounts are rejected outside this isolated preview server.
