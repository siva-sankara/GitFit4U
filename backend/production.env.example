# Import these public settings into the BACKEND Vercel project's Production environment.
# Fill these only in Vercel; never commit real values.
NODE_ENV=production
MONGO_URI=
CLIENT_ORIGIN=https://www.getfit4u.in,https://getfit4u.in,https://git-fit4-u.vercel.app
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUTH_OTP_HMAC_SECRET=
ATTENDANCE_QR_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=3d
LOG_LEVEL=info
FRONTEND_URL=https://www.getfit4u.in
BACKEND_PUBLIC_URL=https://git-fit4-u-un7d.vercel.app
# This must be registered on the same Razorpay application/client as your credentials.
RAZORPAY_OAUTH_REDIRECT_URI=https://git-fit4-u-un7d.vercel.app/api/v1/payments/razorpay/oauth/callback
# Retain the existing RAZORPAY_OAUTH_CLIENT_ID, RAZORPAY_OAUTH_CLIENT_SECRET,
# RAZORPAY_OAUTH_WEBHOOK_SECRET and PAYMENT_TOKEN_ENCRYPTION_KEY in Vercel.
# RAZORPAY_GYM_OAUTH_ENABLED=true is required. Keep RAZORPAY_MODE consistent
# with that OAuth client and every backend instance; test and live are separate.
# COOKIE_DOMAIN must remain unset for the host-only refresh cookie.
