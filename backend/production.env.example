# Import these public settings into the BACKEND Vercel project's Production environment.
# Fill these only in Vercel; never commit real values.
NODE_ENV=production
MONGO_URI=
CLIENT_ORIGIN=https://www.getfit4u.in,https://getfit4u.in,https://git-fit4-u.vercel.app
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
