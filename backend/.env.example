NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/getfit4u
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-48-random-characters-for-production
JWT_REFRESH_SECRET=replace-with-a-different-48-character-production-secret
ATTENDANCE_QR_SECRET=replace-with-a-third-independent-48-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=
REDIS_URL=redis://127.0.0.1:6379
# Server-only Razorpay credentials. Use matching test or live mode for keys and webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Match the secret configured for POST https://<backend>/api/v1/webhooks/razorpay.
# Events: payment.captured, order.paid, payment.failed. Required to enable checkout.
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
# Legacy maps disabled: GOOGLE_MAPS_API_KEY=
# Firebase Cloud Messaging service account (server only; same project as frontend)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Quote the private key and use \n for line breaks. Never expose it through VITE_ variables.
FIREBASE_PRIVATE_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=getfit4u-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=ap-south-1
LOG_LEVEL=info

# LocationIQ geocoding and map tiles (server-side token)
LOCATIONIQ_API_KEY=
LOCATIONIQ_REGION=us1
