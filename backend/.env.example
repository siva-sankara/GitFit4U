NODE_ENV=
PORT=
MONGO_URI=
CLIENT_ORIGIN=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUTH_OTP_HMAC_SECRET=
AUTH_OTP_DUAL_DELIVERY_ENABLED=false
AUTH_OTP_EMAIL_PROVIDER=microsoft_graph
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_DELIVERY_ENCRYPTION_KEY=
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER_MAILBOX=support@getfit4u.in
M365_FROM_EMAIL=support@getfit4u.in
M365_FROM_NAME=GETFIT4U
M365_REPLY_TO=support@getfit4u.in
ATTENDANCE_QR_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=3d
COOKIE_DOMAIN=
REDIS_URL=
PAYMENT_PROVIDER=razorpay
RAZORPAY_MODE=test
# All new flows remain fail-closed until the matching credentials, provider
# approval and webhook subscriptions have been configured and tested.
RAZORPAY_PLATFORM_PAYMENTS_ENABLED=false
RAZORPAY_GYM_OAUTH_ENABLED=false
RAZORPAY_GYM_QR_ENABLED=false
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_SUBSCRIPTIONS_ENABLED=false

# GETFIT4U/Admin merchant: platform fees only.
RAZORPAY_PLATFORM_KEY_ID=
RAZORPAY_PLATFORM_KEY_SECRET=
RAZORPAY_PLATFORM_ACCOUNT_ID=
RAZORPAY_PLATFORM_WEBHOOK_SECRET=

# Approved Technology Partner application: gym-owned merchant consent.
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=
RAZORPAY_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/payments/razorpay/oauth/callback
RAZORPAY_OAUTH_WEBHOOK_SECRET=

# 32 random bytes encoded as 64 hex characters. Server-side only.
PAYMENT_TOKEN_ENCRYPTION_KEY=
PAYMENT_TOKEN_ENCRYPTION_KEY_VERSION=1
FRONTEND_URL=https://www.getfit4u.in
BACKEND_PUBLIC_URL=https://api.example.com

# Legacy aliases used by historical platform/Route records during migration.
# Prefer the scoped RAZORPAY_PLATFORM_* names above for new deployments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Historical Route reconciliation only. Do not enable for new memberships.
# Supported live membership policy: platform_absorbs. gym_deducts_actual stays
# fail-closed until account-specific charges can be calculated authoritatively.
RAZORPAY_GYM_FEE_BEARER=
GOOGLE_CLIENT_ID=

RESEND_API_KEY=
EMAIL_FROM=
EMAIL_ENCRYPTION_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_REGION=
LOG_LEVEL=
WHATSAPP_MODE=live
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=

WHATSAPP_API_VERSION=v26.0
WHATSAPP_DEFAULT_LANGUAGE=en_US
# Must be an APPROVED AUTHENTICATION template with a five-minute expiry and Copy Code button.
# Utility welcome/renewal templates and hello_world cannot send signup OTPs.
# Example submission body: config/whatsapp-auth-template.example.json (requires Meta approval).
WHATSAPP_AUTH_TEMPLATE_NAME=
WHATSAPP_AUTH_TEMPLATE_LANGUAGE=en_US
OTP_MODE=whatsapp
OTP_DEV_PREVIEW_ENABLED=false
# For isolated local signup/login tests only, see .env.otp-preview.example.
WHATSAPP_WEBHOOK_RETENTION_DAYS=30
WHATSAPP_WORKER_ENABLED=false
WHATSAPP_COEXISTENCE_ENABLED=false
WHATSAPP_COEXISTENCE_CONFIG_ID=

LOCATIONIQ_API_KEY=
LOCATIONIQ_REGION=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_BUCKET_NAME=
MEDIA_STORAGE_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
